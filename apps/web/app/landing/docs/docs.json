{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Stellar Tools",
  "description": "The financial infrastructure for the Stellar economy.",
  "fonts": {
    "heading": {
      "family": "Instrument Serif"
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "colors": {
    "primary": "#fdda24",
    "light": "#fdda24",
    "dark": "#fdda24"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["index"]
          },
          {
            "group": "Concepts",
            "pages": ["products"]
          },
          {
            "group": "Integrations",
            "pages": [
              {
                "group": "SDK",
                "expanded": false,
                "pages": ["integrations/typescript-sdk"]
              },
              "integrations/mcp",
              {
                "group": "Framework Adapters",
                "expanded": false,
                "pages": [
                  "integrations/aisdk",
                  "integrations/langchain",
                  "integrations/medusajs",
                  "integrations/betterauth",
                  "integrations/uploadthing",
                  "integrations/woocommerce"
                ]
              }
            ]
          },
          {
            "group": "Marketplace",
            "pages": ["marketplace/building-apps", "marketplace/resend", "marketplace/loops"]
          },
          {
            "group": "Webhooks",
            "pages": ["webhooks"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction", "api-reference/authentication"]
          },
          {
            "group": "Resources",
            "pages": [
              "api-reference/customers",
              "api-reference/portal",
              "api-reference/products",
              "api-reference/checkouts",
              "api-reference/subscriptions",
              "api-reference/payments",
              "api-reference/refunds",
              "api-reference/webhooks",
              "api-reference/usage"
            ]
          },
          {
            "group": "Reference Data",
            "pages": ["api-reference/assets", "api-reference/currencies"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Home",
          "href": "/",
          "icon": "house"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logo-light.png",
    "dark": "/logo/logo-dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:odii@stellartools.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign Up Free",
      "href": "https://dashboard.stellartools.dev/signup",
      "target": "_blank"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/stellartoolsorg",
      "github": "https://github.com/payrouteshq/stellartools",
      "linkedin": "https://www.linkedin.com/company/stellartoolsorg"
    }
  }
}
