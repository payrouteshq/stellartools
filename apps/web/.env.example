# Postgres connection string
DATABASE_URL=
NODE_ENV=

# Transactional email (receipts, invites, etc.) via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Signs session/org-selection JWTs — set to a long random string
JWT_SECRET=

# Google OAuth login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed if you expose your instance via a Cloudflare Tunnel (see docker-compose.yml)
CLOUDFLARE_TUNNEL_TOKEN=

NEXT_PUBLIC_APP_URL=
COOKIE_DOMAIN=
NEXT_PUBLIC_CHECKOUT_URL=
NEXT_PUBLIC_DASHBOARD_URL=
NEXT_PUBLIC_PORTAL_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_INVOICE_URL=http://invoice.localhost:3000

# Encrypts organization secret keys at rest — set both to long random strings
MASTER_ENCRYPTION_KEY=
ENCRYPTION_SALT=

# Deployed subscription-engine contract ID per network (see apps/web/soroban/)
SUBSCRIPTION_CONTRACT_TESTNET_ID=
SUBSCRIPTION_CONTRACT_MAINNET_ID=

NEXT_PUBLIC_RPC_URL_TESTNET=
NEXT_PUBLIC_RPC_URL_MAINNET=
NEXT_PUBLIC_STELLAR_HORIZON_TESTNET=
NEXT_PUBLIC_STELLAR_HORIZON_MAINNET=

# "Keeper" account that pays Stellar network fees for subscription contract calls.
# This is YOUR account — fund it with a small amount of XLM per network. StellarTools
# never touches it and never charges you a platform fee on top of it.
KEEPER_SECRET_TESTNET=
KEEPER_SECRET_MAINNET=

NEXT_PUBLIC_CAL_LINK=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
RESEND_APP_BASE_URL=http://localhost:3001
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
RESEND_CC_EMAILS=
GSHEETS_SERVICE_ACCOUNT_KEY_B64=
NEXT_PUBLIC_RESOURCE_ID_ALPHABET=

# Shared secret required to call the /~api/cron/* endpoints (see self-host docs
# for how to trigger them on a schedule outside of Vercel)
CRON_SECRET=
