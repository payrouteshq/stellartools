# ── Required ──────────────────────────────────────────────────────────────

# Postgres connection string. docker-compose.yml overrides this to point at
# the `database` service automatically — you only need to set it yourself
# for a non-Docker (`pnpm dev`) setup.
DATABASE_URL=postgresql://postgres:local@localhost:5436/postgres
# Leave blank for `pnpm dev` / `docker compose` — both set this appropriately
# on their own. Only set it yourself for a custom deployment setup.
NODE_ENV=

# Transactional email (OTP codes, receipts, invites) via Resend. Required for
# account signup/login to work — get a free key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Base62 alphabet used to generate resource IDs (org_, pay_, sub_, etc). Any
# 62-character string of unique characters works — this default is fine to
# leave as-is.
NEXT_PUBLIC_RESOURCE_ID_ALPHABET=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz

# ── App URLs ──────────────────────────────────────────────────────────────
# The dashboard, checkout, portal, invoice, and API surfaces are routed by
# hostname (see proxy.ts) — each needs its own URL. Most browsers/OSes
# resolve *.localhost to 127.0.0.1 automatically, so these defaults work
# out of the box for local self-hosting. Replace with your real domains
# (e.g. https://dashboard.yourdomain.com) once you're ready to go live.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://dashboard.localhost:3000
NEXT_PUBLIC_CHECKOUT_URL=http://checkout.localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://portal.localhost:3000
NEXT_PUBLIC_API_URL=http://api.localhost:3000
NEXT_PUBLIC_INVOICE_URL=http://invoice.localhost:3000
NEXT_PUBLIC_DOCS_URL=https://docs.stellartools.dev

# Leading dot shares the session cookie across the *.localhost subdomains
# above. Set to your real domain (e.g. .yourdomain.com) in production.
COOKIE_DOMAIN=.localhost

# ── Secrets ───────────────────────────────────────────────────────────────
# Leave these blank for local self-hosting via Docker — the container
# generates and persists them on first boot (see apps/web/docker-entrypoint.sh).
# Set them explicitly here for anything beyond a local trial, or if you're
# running with `pnpm dev` instead of Docker.
JWT_SECRET=
MASTER_ENCRYPTION_KEY=
ENCRYPTION_SALT=
CRON_SECRET=

# ── Stellar / Soroban ─────────────────────────────────────────────────────
# Deployed subscription-engine contract ID per network — see DEVELOPMENT.md
# for how to build and deploy it. Only needed for subscription features;
# the rest of the app works without it.
SUBSCRIPTION_CONTRACT_TESTNET_ID=
SUBSCRIPTION_CONTRACT_MAINNET_ID=

NEXT_PUBLIC_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
NEXT_PUBLIC_RPC_URL_MAINNET=https://mainnet.sorobanrpc.com
NEXT_PUBLIC_STELLAR_HORIZON_TESTNET=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_MAINNET=https://horizon.stellar.org

# "Keeper" account that pays Stellar network fees for subscription contract
# calls. This is YOUR account — fund it with a small amount of XLM per
# network. StellarTools never touches it and never charges you a platform
# fee on top of it. See DEVELOPMENT.md for how to generate and fund one.
KEEPER_SECRET_TESTNET=
KEEPER_SECRET_MAINNET=

# ── Optional ──────────────────────────────────────────────────────────────

# Google OAuth login (leave blank to only offer email/password login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed if you expose your instance via a Cloudflare Tunnel (see docker-compose.yml)
CLOUDFLARE_TUNNEL_TOKEN=

NEXT_PUBLIC_CAL_LINK=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
RESEND_APP_BASE_URL=http://localhost:3001
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
RESEND_CC_EMAILS=
GSHEETS_SERVICE_ACCOUNT_KEY_B64=
