{% comment %}
  UNSTABLE — demo block. Remove when Shopify grants Payments Partner access.
  Renders a "Pay with Stellar" button on the product page, below Add to cart / Buy it now.
  Works on ALL Shopify plans — no Plus required.
{% endcomment %}

<div
  class="stellar-pay-wrapper"
  data-app-url="{{ block.settings.app_url | escape }}"
  data-shop="{{ shop.myshopify_domain | escape }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-default-price="{{ product.selected_or_first_available_variant.price }}"
  {{ block.shopify_attributes }}
>
  <button type="button" class="stellar-pay-btn" aria-label="Pay with Stellar">
    <span class="stellar-pay-icon">
      {%- render 'stellar-icon', width: 18, height: 16 -%}
    </span>
    <span class="stellar-pay-label">Pay with Stellar</span>
    <span class="stellar-pay-spinner" style="display:none">&#8987;</span>
  </button>
  <p class="stellar-pay-error" role="alert" style="display:none"></p>
</div>

<style>
  .stellar-pay-wrapper {
    margin-top: 8px;
  }
  .stellar-pay-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px 20px;
    background: #1a1a2e;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .stellar-pay-btn:hover { opacity: 0.88; }
  .stellar-pay-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .stellar-pay-icon { display: flex; align-items: center; }
  .stellar-pay-error {
    margin-top: 8px;
    font-size: 13px;
    color: #c0392b;
  }
</style>

<script src="{{ 'stellar-pay-button.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Stellar Pay Button",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App Backend URL",
      "info": "Your StellarTools Shopify app URL (e.g. https://xxxx.ngrok-free.app). Set this after starting your dev server."
    }
  ],
}
{% endschema %}
