# Create/link the app first: pnpm exec shopify app config link
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Leave blank during local dev — `pnpm dev` sets the tunnel URL automatically.
SHOPIFY_APP_URL=

DEV_STORE_URL=stellartools-testnet.myshopify.com
DATABASE_URL=postgresql://postgres:local@localhost:5436/shopify_app
STELLARTOOLS_API_URL=
STELLARTOOLS_DASHBOARD_URL=
