# HighLevel Marketplace app credentials (from your app's listing in marketplace.gohighlevel.com)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# Optional: passed to HighLevel's "Update Capabilities" API and shown in provider listings.
GHL_MARKETPLACE_APP_ID=
GHL_PROVIDER_NAME=StellarTools
GHL_PROVIDER_DESCRIPTION=Accept Stellar-native payments and stablecoins.
GHL_PROVIDER_LOGO_URL=

# This app's own public URL (no trailing slash) — used for the OAuth redirect_uri, queryUrl base,
# and the StellarTools webhook URLs it registers.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Where apps/web is deployed (no trailing slash) — the UI (checkout iframe, config page, connect
# confirmation) lives there. paymentsUrl registered with HighLevel points at
# `${STELLARTOOLS_WEB_APP_URL}/ghl/checkout`.
STELLARTOOLS_WEB_APP_URL=http://localhost:3000

GHL_APP_DATABASE_URL=postgresql://root:local@localhost:5437/ghl_app

# 32-byte hex key for AES-256-GCM encryption of stored StellarTools secret keys, e.g.
# `openssl rand -hex 32`
GHL_APP_ENCRYPTION_KEY=

# Shared with apps/web — checked on requests apps/web proxies in here (/api/checkout,
# /api/connect-stellar) so they can't be hit directly by anyone else. Any random string.
GHL_INTERNAL_API_SECRET=

# Signs/verifies the OAuth `state` param that carries a StellarTools app token through the
# GoHighLevel install redirect, so a location gets auto-provisioned without a pasted API key.
# Self-contained to this app — nothing else needs to know it. Any 32+ byte random string.
GHL_STATE_SIGNING_SECRET=

# Protects /api/cron/renew-subscriptions from unauthenticated calls (Vercel Cron sends this as
# a Bearer token automatically when set). Optional locally.
CRON_SECRET=
