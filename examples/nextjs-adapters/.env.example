# StellarTools API key — get yours at https://dashboard.stellartools.dev/api-keys
STELLARTOOLS_API_KEY=st_live_...

# The product ID to gate access behind (used by aisdk, langchain, uploadthing adapters)
STELLARTOOLS_PRODUCT_ID=prod_...

# The product permanent link to gate access behind
NEXT_PUBLIC_STELLARTOOLS_PRODUCT_PERMALINK=https://checkout.stellartools.dev/products/...

# OpenAI key (used by aisdk + langchain demos)
OPENAI_API_KEY=sk-...

# App URL (used by better-auth)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Better Auth Postgres 
BETTER_AUTH_DATABASE_URL=postgresql://root:local@localhost:5436/better_auth_adapter_playground

# UploadThing credentials (https://uploadthing.com)
UPLOADTHING_TOKEN=...
