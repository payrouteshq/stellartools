{
  "name": "@stellartools/core",
  "version": "0.0.4",
  "description": "Core SDK for Stellar Tools API",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm run build:prod",
    "build:dev": "export $(cat .env.development | xargs) && tsup",
    "build:prod": "STELLAR_TOOLS_BASE_URL=${STELLAR_TOOLS_BASE_URL:-$(cat .env.production | grep STELLAR_TOOLS_BASE_URL | cut -d= -f2)} tsup",
    "lint:localhost": "if grep -qr 'localhost' dist; then echo '✗ ERROR: Localhost leaked into dist!'; exit 1; else echo '✓ Dist is clean.'; fi",
    "prepublishOnly": "[ -n \"$CI\" ] && pnpm run lint:localhost || (pnpm run build:prod && pnpm run lint:localhost)"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "keywords": [
    "stellar",
    "tools",
    "adapter"
  ],
  "author": "Emmanuel Odii",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/payrouteshq/stellartools.git"
  },
  "bugs": {
    "url": "https://github.com/payrouteshq/stellartools/issues"
  },
  "dependencies": {
    "better-result": "^2.5.1",
    "jsonwebtoken": "^9.0.3",
    "ky": "^1.14.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9",
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
