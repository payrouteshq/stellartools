{
  "name": "@stellartools/subscription-contract",
  "version": "0.0.1",
  "description": "Typed client bindings for the StellarTools subscription-engine Soroban contract",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch"
  },
  "keywords": [
    "stellar",
    "soroban",
    "subscriptions",
    "contract-bindings"
  ],
  "author": "Emmanuel Odii",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/payrouteshq/stellartools.git"
  },
  "bugs": {
    "url": "https://github.com/payrouteshq/stellartools/issues"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "14.1.1",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
