{
  "name": "stellartools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @stellartools/web dev",
    "build:web": "pnpm --filter @stellartools/web build",
    "start": "pnpm --filter @stellartools/web start",
    "lint": "pnpm --filter @stellartools/web lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "tailwind:fix": "tailwind-lint --fix \"apps/**/*.{tsx,jsx}\" \"packages/**/*.{tsx,jsx}\" \"examples/**/*.{tsx,jsx}\"",
    "build:packages": "pnpm --recursive --filter './packages/*' run build",
    "type-check": "pnpm --filter @stellartools/web exec npx tsc --noEmit",
    "changeset:version": "pnpm changeset version",
    "changeset:publish": "pnpm changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@tailwindcss/postcss": "^4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "eslint-plugin-storybook": "^10.1.10",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwind-lint": "^0.12.1",
    "storybook": "^8.6.15",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.15",
      "@types/react-dom": "19.2.3",
      "@mikro-orm/core": "6.6.14",
      "@mikro-orm/knex": "6.6.14",
      "@mikro-orm/postgresql": "6.6.14"
    },
    "neverBuiltDependencies": [
      "usb"
    ]
  }
}
