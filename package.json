{
  "name": "stellartools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n next,mint \"next dev\" \"cd app/landing/docs && pnpm dlx mintlify dev --port 3333\"",
    "build": "pnpm -C packages/stellartools run build:dev && pnpm -C packages/app-embed-bridge run build && next build --webpack",
    "web:build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "scan": "npx fix-react2shell-next",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "build:packages": "pnpm --recursive --filter './packages/*' run build",
    "changeset:version": "pnpm changeset version",
    "changeset:publish": "pnpm changeset publish"
  },
